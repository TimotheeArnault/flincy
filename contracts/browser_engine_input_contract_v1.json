  "explanation": {
    "bucket": {
      "allocated_budget_points": "effective_bucket_weight * 100",
      "earned_points": "evaluable_budget_points * bucket_score_raw / 100",
      "evaluable_budget_points": "allocated_budget_points * bucket_coverage_raw",
      "missed_points": "evaluable_budget_points - earned_points",
      "unknown_points": "allocated_budget_points - evaluable_budget_points"
    },
    "component": {
      "allocated_budget_points": "bucket_allocated_budget_points * effective_component_weight",
      "earned_points": "evaluable_budget_points * component_score_raw / 100",
      "effective_component_weight": "configured_component_weight / sum(configured_component_weight for listing-active components)",
      "evaluable_budget_points": "allocated_budget_points * component_coverage_raw",
      "inactive_component": "allocated_budget_points = 0 and excluded before renormalization",
      "missed_points": "evaluable_budget_points - earned_points",
      "unknown_points": "allocated_budget_points - evaluable_budget_points"
    },
    "criterion": {
      "allocated_budget_points": "component_allocated_budget_points * atomic_weight",
      "earned_points": "evaluable_budget_points * criterion_score_raw / 100",
      "evaluable_budget_points": "allocated_budget_points when criterion_is_usable else 0",
      "missed_points": "evaluable_budget_points - earned_points",
      "unknown_points": "allocated_budget_points - evaluable_budget_points"
    },
    "display_rounding": "frontend_only",
    "evidence_partition": {
      "ambiguous": "unknown_non_evaluable",
      "confirmed_negative": "evaluable_missed",
      "invalid_observation": "unknown_non_evaluable",
      "no_positive_evidence_after_valid_observation": "evaluable_missed",
      "truly_unresolved": "unknown_non_evaluable"
    },
    "global": {
      "coverage": "total_evaluable_budget / total_allocated_budget",
      "partition": "total_allocated_budget = total_earned_points + total_missed_points + total_unknown_points",
      "total_allocated_budget": 100.0,
      "user_fit_score": "total_earned_points / total_evaluable_budget * 100 when total_evaluable_budget > 0"
    },
    "point_scale": 100.0,
    "precision": "raw_binary_float_for_parity"
  },
  "fit_contract_version": "fit_product_calibration_v1",
  "forbidden_browser_recomputation": [
